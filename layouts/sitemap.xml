{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{- range site.Pages }}
    {{- $robots := .Params.robots | default "" -}}
    {{- if and .Permalink (ne .Kind "home") (not (in (slice "taxonomy" "term") .Kind)) (not (in $robots "noindex")) (not (strings.HasSuffix .Permalink ".md")) }}
  <url>
    <loc>{{ .Permalink }}</loc>
    {{- if not .Lastmod.IsZero }}
    <lastmod>{{ .Lastmod.Format "2006-01-02" }}</lastmod>
    {{- end }}
    <changefreq>{{ if .IsSection }}weekly{{ else }}weekly{{ end }}</changefreq>
    <priority>{{ if .IsSection }}0.8{{ else }}0.6{{ end }}</priority>
  </url>
    {{- end }}
  {{- end }}
</urlset>
